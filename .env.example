# AutoTest AI — environment template (Phase 0).
# Copy to .env and fill in. NEVER commit .env or real secrets.

# ---------- PostgreSQL ----------
POSTGRES_DB=autotestai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# ---------- Keycloak ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_PORT=8080
AUTH_AUTHORITY=http://localhost:8080/realms/autotestai
AUTH_AUDIENCE=autotestai-api

# ---------- Temporal ----------
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8088

# ---------- Valkey (Redis protocol) ----------
VALKEY_PORT=6379

# ---------- MinIO / S3-compatible storage ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-min-8-chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=autotestai-artifacts

# ---------- API ----------
API_PORT=5193

# ---------- Web ----------
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5193
VITE_SIGNALR_HUB_URL=http://localhost:5193/hubs/execution
VITE_KEYCLOAK_URL=http://localhost:8080

# ---------- AI (Slice 4 gateway; stub remains the zero-config default) ----------
# Server-side only. Never prefix these with VITE_ and never return them to the frontend.
# AI__Provider: stub | ollama | openai | gemini (planned/unsupported for now)
AI__PROVIDER=stub
AI__MODEL=
# Ollama base URL (also used as an OpenAI-compatible endpoint override when set explicitly).
AI__BASE_URL=http://localhost:11434
AI__API_KEY=
AI__TIMEOUT_SECONDS=120
AI__TEMPERATURE=0.2
AI__MAX_OUTPUT_TOKENS=4096
AI__MAX_GENERATIONS_PER_MINUTE_PER_PROJECT=20
# Legacy aliases kept for reference (Phase 0 shape):
AI_DEFAULT_PROVIDER=stub
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- Observability (optional OTLP endpoint, e.g. Grafana Alloy) ----------
OTLP_ENDPOINT=
