{
  "realm": "autotestai",
  "enabled": true,
  "displayName": "AutoTest AI",
  "roles": {
    "realm": [
      { "name": "admin", "description": "Platform administrator (FR-1.1)" },
      { "name": "qa-lead", "description": "QA lead / manager (FR-1.1)" },
      { "name": "tester", "description": "Test automation engineer / QA tester (FR-1.1)" },
      { "name": "viewer", "description": "Read-only viewer (FR-1.1)" }
    ]
  },
  "clients": [
    {
      "clientId": "autotestai-web",
      "name": "AutoTest AI web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "autotestai-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "autotestai-api",
      "name": "AutoTest AI API audience",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ]
}
